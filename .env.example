# Copy to .env (optional). All values have working defaults.
# Database: SQLite by default (zero setup). For PostgreSQL/PostGIS later:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/skillpulse
DATABASE_URL=
SKILLPULSE_DATA_DIR=
# Gap thresholds are ratios of (forecast demand - capacity) / forecast demand
SHORTAGE_THRESHOLD=0.10
SURPLUS_THRESHOLD=-0.10
EW_LOW_MAX=0.10
EW_GROWING_MAX=0.25
CAPACITY_GROWTH_PCT=0
TRANSITION_MIN_FIT=40
